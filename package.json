{
  "name": "giwin-studio",
  "version": "0.4.39",
  "description": "极物 GIWIN Studio · 室内设计方案画布",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-installer.ps1",
    "publish:update": "node scripts/publish-update.mjs",
    "release:push": "node scripts/release-push.mjs",
    "site:sync": "node scripts/sync-site.mjs",
    "release:all": "node scripts/release-all.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",
    "konva": "^9.3.0",
    "marzipano": "^0.10.2"
  }
}
